.archivo-fieldset {
    border: 1px solid #ddd;
    border-radius: 6px;
    background: #fafafa;
}

.archivo-resolucion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.archivo-vacio {
    color: #777;
    font-style: italic;
}

.archivo-preview {
    font-size: 0.9rem;
    color: #555;
    background: #f8f9fa;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
}